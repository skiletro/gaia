+	if (!first_draw && wlr_box_equal(&c->drop_animation.target, &drop_box))
+		return;
+	c->drop_animation.target = drop_box;
+
+	/* On a target switch, continue from the previous guide's screen position. */
+	Client *previous = first_draw ? server.drop_client : NULL;
+	bool transfer = previous && previous != c && previous->mon == c->mon;
+	if (!config.animations || (first_draw && !transfer)) {
+		c->drop_animation.running = false;
+		client_draw_drop_outline(c, &drop_box);
+		return;
+	}
+
+	struct wlr_scene_rect *from = transfer ? previous->droparea : c->droparea;
+	int32_t x = from->node.x, y = from->node.y;
+	if (transfer) {
+		/* Convert the previous layer's position to the new guide's layer. */
+		wlr_scene_node_coords(&from->node, &x, &y);
+		x -= parent_x;
+		y -= parent_y;
+	}
+	c->drop_animation.initial =
+		(struct wlr_box){x, y, from->width, from->height};
+	c->drop_animation.time_started = get_now_in_ms();
+	c->drop_animation.duration = MANGO_MIN(config.animation_duration_move, 150);
+	c->drop_animation.running =
+		!wlr_box_equal(&c->drop_animation.initial, &drop_box);
+	client_draw_drop_outline(c, &c->drop_animation.initial);
+	if (c->drop_animation.running)
+		request_fresh_all_monitors();
 }
 
