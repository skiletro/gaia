+static bool parse_device_accel_profile(const char *value, int32_t *profile) {
+	char *end;
+	errno = 0;
+	long parsed = strtol(value, &end, 10);
+	if (end == value || errno == ERANGE)
+		return false;
+	while (isspace((unsigned char)*end))
+		end++;
+	if (*end || (parsed != 0 && parsed != 1 && parsed != 2 && parsed != 4))
+		return false;
+	*profile = (int32_t)parsed;
+	return true;
+}
+
+/* Advance without tokenizing: the enclosing device rule uses strtok on commas. */
+static bool parse_custom_accel_value(const char **cursor, double *value,
+									bool allow_zero) {
+	const char *start = *cursor;
+	while (isspace((unsigned char)*start))
+		start++;
+	char *end;
+	errno = 0;
+	double parsed = strtod(start, &end);
+	if (end == start || errno == ERANGE || !isfinite(parsed) ||
+		parsed > 10000.0 || (allow_zero ? parsed < 0.0 : parsed <= 0.0))
+		return false;
+	while (isspace((unsigned char)*end))
+		end++;
+	*cursor = end;
+	*value = parsed;
+	return true;
+}
+
+static bool parse_custom_accel_scalar(const char *value, double *result) {
+	return parse_custom_accel_value(&value, result, false) && *value == '\0';
+}
+
+static bool parse_custom_accel_points(const char *value,
+									 ConfigDeviceRule *rule) {
+	int32_t count = 0;
+	for (;;) {
+		if (count == 64 ||
+			!parse_custom_accel_value(&value, &rule->accel_custom_points[count],
+									  true))
+			return false;
+		count++;
+		if (*value == '\0')
+			break;
+		if (*value != '|')
+			return false;
+		value++;
+	}
+	if (count < 2)
+		return false;
+	rule->accel_custom_points_count = count;
+	return true;
+}
