+static bool pointer_apply_custom_accel(struct libinput_device *device,
+									 const ConfigDeviceRule *rule) {
+	struct libinput_config_accel *accel_config = NULL;
+	enum libinput_config_status status = LIBINPUT_CONFIG_STATUS_UNSUPPORTED;
+	const char *reason = NULL;
+
+	if (!libinput_device_config_accel_is_available(device) ||
+		!(libinput_device_config_accel_get_profiles(device) &
+		  LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM))
+		goto fail;
+
+	accel_config =
+		libinput_config_accel_create(LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM);
+	if (!accel_config) {
+		reason = "allocation failed";
+		goto fail;
+	}
+
+	const double fallback_points[] = {0.0, rule->accel_custom_fallback};
+	status = libinput_config_accel_set_points(
+		accel_config, LIBINPUT_ACCEL_TYPE_FALLBACK, 1.0, 2, fallback_points);
+	if (status != LIBINPUT_CONFIG_STATUS_SUCCESS)
+		goto fail;
+
+	/* Leave SCROLL unset so it inherits the constant-gain fallback. */
+	status = libinput_config_accel_set_points(
+		accel_config, LIBINPUT_ACCEL_TYPE_MOTION, rule->accel_custom_step,
+		rule->accel_custom_points_count, rule->accel_custom_points);
+	if (status != LIBINPUT_CONFIG_STATUS_SUCCESS)
+		goto fail;
+
+	status = libinput_device_config_accel_apply(device, accel_config);
+	if (status != LIBINPUT_CONFIG_STATUS_SUCCESS)
+		goto fail;
+
+	libinput_config_accel_destroy(accel_config);
+	return true;
+
+fail:
+	if (accel_config)
+		libinput_config_accel_destroy(accel_config);
+	mango_error(false, WLR_ERROR,
+				"Failed to apply custom trackpad acceleration for %s: %s",
+				libinput_device_get_name(device),
+				reason ? reason : libinput_config_status_to_str(status));
+	return false;
+}
