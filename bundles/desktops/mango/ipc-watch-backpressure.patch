 /* ---------- Watch mode support ---------- */
+/* Bound memory held by a watcher that never resumes reading. */
+#define IPC_WATCH_QUEUE_LIMIT (1024 * 1024)
+
+struct ipc_watch_message {
+	struct wl_list link;
+	size_t len;
+	size_t offset;
+	char data[];
+};
+
+static bool ipc_flush_watch_client(struct ipc_watch_client *wc) {
+	while (!wl_list_empty(&wc->pending)) {
+		struct ipc_watch_message *msg =
+			wl_container_of(wc->pending.next, msg, link);
+		ssize_t n = send(wc->fd, msg->data + msg->offset,
+						 msg->len - msg->offset, MSG_NOSIGNAL);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+			return true;
+		if (n <= 0)
+			return false;
+		msg->offset += n;
+		if (msg->offset == msg->len) {
+			wc->queued_bytes -= msg->len;
+			wl_list_remove(&msg->link);
+			free(msg);
+		}
+	}
+	return wl_event_source_fd_update(
+			   wc->source, WL_EVENT_READABLE | WL_EVENT_HANGUP | WL_EVENT_ERROR) == 0;
+}
+
+static void ipc_send_watch_client(struct ipc_watch_client *wc,
+								 const char *data, size_t len) {
+	size_t offset = 0;
+	bool was_empty = wl_list_empty(&wc->pending);
+	if (was_empty) {
+		ssize_t n;
+		do {
+			n = send(wc->fd, data, len, MSG_NOSIGNAL);
+		} while (n < 0 && errno == EINTR);
+		if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+			goto disconnect;
+		if (n == 0)
+			goto disconnect;
+		if (n > 0)
+			offset = n;
+		if (offset == len)
+			return;
+	}
+
+	/* Queue only unsent bytes; never interleave JSON lines after a short send. */
+	size_t remaining = len - offset;
+	if (remaining > IPC_WATCH_QUEUE_LIMIT - wc->queued_bytes)
+		goto disconnect;
+	struct ipc_watch_message *msg = malloc(sizeof(*msg) + remaining);
+	if (!msg)
+		goto disconnect;
+	msg->len = remaining;
+	msg->offset = 0;
+	memcpy(msg->data, data + offset, remaining);
+	wl_list_insert(wc->pending.prev, &msg->link);
+	wc->queued_bytes += remaining;
+	if (was_empty && wl_event_source_fd_update(
+			wc->source, WL_EVENT_READABLE | WL_EVENT_WRITABLE |
+							WL_EVENT_HANGUP | WL_EVENT_ERROR) < 0)
+		goto disconnect;
+	return;
+
+disconnect:
+	ipc_remove_watch_client(wc);
+}
