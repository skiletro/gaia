+static void client_draw_drop_outline(Client *c, const struct wlr_box *box) {
+	int32_t stroke =
+		MANGO_MIN(3, MANGO_MAX(1, MANGO_MIN(box->width, box->height) / 2));
+	int32_t radius =
+		MANGO_MIN(config.border_radius, MANGO_MIN(box->width, box->height) / 2);
+	struct clipped_region clipped_region = {
+		.area = {stroke, stroke, GEZERO(box->width - 2 * stroke),
+				 GEZERO(box->height - 2 * stroke)},
+		.corners = corner_radii_all(MANGO_MAX(0, radius - stroke)),
+	};
+
+	wlr_scene_node_set_position(&c->droparea->node, box->x, box->y);
+	wlr_scene_rect_set_size(c->droparea, box->width, box->height);
+	wlr_scene_rect_set_corner_radii(c->droparea, corner_radii_all(radius));
+	wlr_scene_rect_set_clipped_region(c->droparea, clipped_region);
+}
+
+static bool client_step_drop_animation(Client *c) {
+	if (!c->droparea || !c->droparea->node.enabled)
+		return false;
+	if (!c->enable_drop_area_draw || !c->scene->node.enabled || !c->mon ||
+		!VISIBLEON(c, c->mon)) {
+		c->drop_animation.running = false;
+		wlr_scene_node_set_enabled(&c->droparea->node, false);
+		return false;
+	}
+	if (!c->drop_animation.running)
+		return false;
+
+	uint32_t elapsed = get_now_in_ms() - c->drop_animation.time_started;
+	if (!config.animations || elapsed >= c->drop_animation.duration) {
+		c->drop_animation.running = false;
+		client_draw_drop_outline(c, &c->drop_animation.target);
+		return false;
+	}
+
+	double progress = find_animation_curve_at(
+		(double)elapsed / c->drop_animation.duration, MOVE);
+	progress = MANGO_MIN(1.0, MANGO_MAX(0.0, progress));
+	const struct wlr_box *initial = &c->drop_animation.initial;
+	const struct wlr_box *target = &c->drop_animation.target;
+	struct wlr_box box = {
+		.x = (int32_t)round(initial->x + (target->x - initial->x) * progress),
+		.y = (int32_t)round(initial->y + (target->y - initial->y) * progress),
+		.width = (int32_t)round(initial->width +
+							   (target->width - initial->width) * progress),
+		.height = (int32_t)round(initial->height +
+								(target->height - initial->height) * progress),
+	};
+	client_draw_drop_outline(c, &box);
+	return true;
+}
