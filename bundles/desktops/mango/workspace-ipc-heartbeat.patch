--- a/src/ipc/ipc.c
+++ b/src/ipc/ipc.c
@@ -517,9 +517,26 @@
 /* ---------- Init & cleanup ---------- */
 static int ipc_socket_fd = -1;
 static struct wl_event_source *ipc_event_source = NULL;
+#define IPC_WORKSPACE_HEARTBEAT_INTERVAL_MS 2000
+static struct wl_event_source *ipc_workspace_heartbeat_source = NULL;
 static char ipc_socket_path[256];
 
+/* Periodic snapshots recover subscribers that miss a workspace event. */
+static int ipc_workspace_heartbeat(void *data) {
+	(void)data;
+	ipc_notify_all_monitors();
+	if (ipc_workspace_heartbeat_source)
+		wl_event_source_timer_update(
+			ipc_workspace_heartbeat_source,
+			IPC_WORKSPACE_HEARTBEAT_INTERVAL_MS);
+	return 0;
+}
+
 void ipc_cleanup(void) {
+	if (ipc_workspace_heartbeat_source) {
+		wl_event_source_remove(ipc_workspace_heartbeat_source);
+		ipc_workspace_heartbeat_source = NULL;
+	}
 	if (ipc_event_source)
 		wl_event_source_remove(ipc_event_source);
 	if (ipc_socket_fd >= 0)
@@ -1359,3 +1376,9 @@
 	ipc_event_source = wl_event_loop_add_fd(
 		loop, ipc_socket_fd, WL_EVENT_READABLE, ipc_handle_connection, loop);
+	ipc_workspace_heartbeat_source =
+		wl_event_loop_add_timer(loop, ipc_workspace_heartbeat, NULL);
+	if (ipc_workspace_heartbeat_source)
+		wl_event_source_timer_update(
+			ipc_workspace_heartbeat_source,
+			IPC_WORKSPACE_HEARTBEAT_INTERVAL_MS);
 }
